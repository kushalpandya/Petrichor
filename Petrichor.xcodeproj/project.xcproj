{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Dev",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/groue/GRDB.swift",
      "version": {
        "up-to-next-major-version": "7.12.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.10.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/kushalpandya/CrescendoKit",
      "version": {
        "up-to-next-major-version": "1.3.0",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "Application", "target-membership": [ "Petrichor" ] },
    { "kind": "folder", "path": "Managers", "target-membership": [ "Petrichor" ] },
    { "kind": "folder", "path": "Models", "target-membership": [ "Petrichor" ] },
    { "kind": "folder", "path": "Views", "target-membership": [ "Petrichor" ] },
    { "kind": "folder", "path": "Core", "target-membership": [ "Petrichor" ] },
    { "kind": "folder", "path": "Utilities", "target-membership": [ "Petrichor" ] },
    { "kind": "folder", "path": "Configuration" },
    {
      "kind": "folder",
      "path": "Resources",
      "target-membership": [
        "Petrichor",
      ],
      "membership-exceptions": [
        {
          "target": "Petrichor",
          "exclusions": [
            "known_artists_YYYYMMDD.txt",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Scripts",
      "target-membership": [
        "Petrichor",
      ],
      "membership-exceptions": [
        {
          "target": "Petrichor",
          "exclusions": [
            "build-installer.sh",
          ],
        },
      ],
    },
    { "path": ".gitignore" },
    { "path": ".swiftlint.yml" },
    { "path": "README.md" },
    { "path": "ACKNOWLEDGEMENTS.md" },
    { "path": "PetrichorApp.swift", "target-membership": [ "Petrichor/compile-sources" ] },
    { "path": "<PRODUCTS>/Petrichor Dev.app", "id": "550F4A0E2DB45B1A005F794E", "type": "wrapper.application", "index": false },
  ],
  "targets": [
    {
      "name": "Petrichor",
      "id": "550F4A0D2DB45B1A005F794E",
      "product": "Petrichor Dev.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Configuration", "relative-path": "Secrets.xcconfig" } },
        { "name": "Dev", "file": { "anchor": "Configuration", "relative-path": "Secrets.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Configuration", "relative-path": "Secrets.xcconfig" } },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "CrescendoKit",
          "product-name": "Crescendo",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "GRDB",
          "product-name": "GRDB",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME[config=Debug]": "AppIconDev",
        "ASSETCATALOG_COMPILER_APPICON_NAME[config=Dev]": "AppIconDev",
        "ASSETCATALOG_COMPILER_APPICON_NAME[config=Release]": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Configuration/Petrichor.entitlements",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "Developer ID Application",
        "CODE_SIGN_STYLE": "Manual",
        "CURRENT_PROJECT_VERSION[config=Debug]": "999",
        "CURRENT_PROJECT_VERSION[config=Dev]": "173",
        "CURRENT_PROJECT_VERSION[config=Release]": "173",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "",
        "DEVELOPMENT_TEAM[sdk=macosx*]": "B53W6J5RWK",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME[config=Debug]": "NO",
        "ENABLE_HARDENED_RUNTIME[config=Dev]": "YES",
        "ENABLE_HARDENED_RUNTIME[config=Release]": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "EXCLUDED_SOURCE_FILE_NAMES[config=Debug]": "AppIcon.icon",
        "EXCLUDED_SOURCE_FILE_NAMES[config=Dev]": "AppIcon.icon",
        "EXCLUDED_SOURCE_FILE_NAMES[config=Release]": "AppIconDev.icon",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Configuration/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Petrichor",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.music",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "15.0",
        "MARKETING_VERSION[config=Debug]": "Development Build",
        "MARKETING_VERSION[config=Dev]": "Development Build",
        "MARKETING_VERSION[config=Release]": "1.7.3",
        "OTHER_CODE_SIGN_FLAGS[config=Dev][sdk=*]": "--timestamp",
        "OTHER_CODE_SIGN_FLAGS[config=Release][sdk=*]": "--timestamp",
        "PETRICHOR_URL_SCHEME[config=Debug]": "petrichor-debug",
        "PETRICHOR_URL_SCHEME[config=Dev]": "petrichor-debug",
        "PETRICHOR_URL_SCHEME[config=Release]": "petrichor",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Debug]": "org.Petrichor.debug",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Dev]": "org.Petrichor.debug",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Release]": "org.Petrichor",
        "PRODUCT_MODULE_NAME[config=Debug]": "Petrichor",
        "PRODUCT_MODULE_NAME[config=Dev]": "Petrichor",
        "PRODUCT_NAME[config=Debug]": "Petrichor Dev",
        "PRODUCT_NAME[config=Dev]": "Petrichor Dev",
        "PRODUCT_NAME[config=Release]": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "arm64",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
